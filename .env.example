# Unraid server URL (e.g. https://192.168.1.100 or https://tower.local)
UNRAID_API_URL=https://tower.local

# Unraid API key — generate in Unraid UI: Settings > Management Access > API Keys
UNRAID_API_KEY=your_api_key_here

# Whether to verify SSL certificates (true/false, or path to CA bundle)
UNRAID_VERIFY_SSL=false

# Bearer token that MCP clients must present to this server
BRAINLESS_MCP_BEARER_TOKEN=change_me_to_a_strong_secret

# Transport: stdio | http | sse | streamable-http
BRAINLESS_MCP_TRANSPORT=stdio

# HTTP server port (used when transport is http/sse/streamable-http)
BRAINLESS_MCP_PORT=8000

# HTTPS / TLS — both must be set together to enable HTTPS (self-signed certs work fine)
# Generate a self-signed cert: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes -subj '/CN=brainless-mcp'
BRAINLESS_MCP_SSL_CERTFILE=
BRAINLESS_MCP_SSL_KEYFILE=

# Let's Encrypt via Cloudflare DNS-01 (set all three to activate automatic cert management)
# Requires: pip install 'brainless-mcp[tls]'  (or use the Docker image, which includes it)
# A Cloudflare API token needs Zone:DNS:Edit permission for the domain's zone.
BRAINLESS_MCP_ACME_EMAIL=
BRAINLESS_MCP_ACME_DOMAIN=
CLOUDFLARE_API_TOKEN=

# Directory where account key, domain key, and cert are stored (default: ~/.brainless-mcp/certs)
BRAINLESS_MCP_ACME_CERT_DIR=

# Set to true to use Let's Encrypt staging (rate-limit-free, untrusted certs) for testing
BRAINLESS_MCP_ACME_STAGING=false

# Seconds to wait for DNS propagation before answering the ACME challenge
BRAINLESS_MCP_ACME_DNS_WAIT=30

# Logging
BRAINLESS_MCP_LOG_LEVEL=INFO
BRAINLESS_MCP_LOG_FILE=

# Auto-start WebSocket subscriptions on startup
UNRAID_AUTO_START_SUBSCRIPTIONS=false

# Max reconnect attempts for WebSocket subscriptions
UNRAID_MAX_RECONNECT_ATTEMPTS=10
